{
  "name": "openrouter-tracker",
  "displayName": "OpenRouter Tracker",
  "description": "Track OpenRouter API usage & budget limits in VS Code",
  "version": "0.1.2",
  "publisher": "r-dimajo",
  "repository": {
    "type": "git",
    "url": "https://github.com/ricca/openrouter-tracker"
  },
  "engines": {
    "vscode": "^1.86.0"
  },
  "categories": [
    "Other"
  ],
  "icon": "icon.png",
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "openrouter-tracker.showDashboard",
        "title": "OpenRouter Tracker: Show Dashboard"
      },
      {
        "command": "openrouter-tracker.refreshStatus",
        "title": "OpenRouter Tracker: Refresh Status"
      }
    ],
    "configuration": {
      "title": "OpenRouter Tracker",
      "properties": {
        "openrouterTracker.managementKey": {
          "type": "string",
          "default": "",
          "description": "OpenRouter Management Key (required for the tracker to work)"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.86.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "dotenv": "^17.4.2"
  },
  "license": "MIT"
}
