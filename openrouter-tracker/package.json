{
  "name": "openrouter-tracker",
  "displayName": "OpenRouter Tracker",
  "description": "Track OpenRouter API usage, costs, and guardrails from the status bar",
  "version": "0.1.0",
  "publisher": "ricca",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "openrouter.openDashboard",
        "title": "OpenRouter: Open Usage Dashboard"
      },
      {
        "command": "openrouter.refresh",
        "title": "OpenRouter: Refresh Data"
      }
    ],
    "configuration": {
      "title": "OpenRouter Tracker",
      "properties": {
        "openrouter.managementKey": {
          "type": "string",
          "default": "",
          "description": "OpenRouter Management API Key (from https://openrouter.ai/settings/management-keys)"
        },
        "openrouter.refreshInterval": {
          "type": "number",
          "default": 300,
          "description": "Auto-refresh interval in seconds (0 = disabled)"
        },
        "openrouter.apiKeyId": {
          "type": "string",
          "default": "",
          "description": "Specific API key hash to track (leave empty to auto-detect first key)"
        }
      }
    }
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/vscode": "^1.125.0",
    "typescript": "^7.0.2"
  }
}
